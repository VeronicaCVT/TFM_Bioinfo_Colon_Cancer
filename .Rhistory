labs(title= "PCA: Normal (PN) vs Tumor (PT)",
x=paste0('PC1 (', round(varianza.explicada[1] * 100, 2), '%)'),
y=paste0('PC2 (', round(varianza.explicada[2] * 100, 2),'%)'),
color='Condición') +
tema_paper
